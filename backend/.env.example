# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# Local Postgres example:
DATABASE_URL=postgresql://sellsy:sellsy_dev_pw@localhost:5432/sellsy_db
# Neon (free hosted Postgres) example:
# DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require

# --- CORS ---
# Comma-separated list of origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:3000

# --- AI (Groq) — not used yet in this phase, safe to leave as placeholders ---
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Razorpay Test Mode — not used yet in this phase, safe to leave as placeholders ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here